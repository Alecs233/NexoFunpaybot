# Discord Bot Token & Channel ID (Optional, for Real Discord Bot presence Online 🟢)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Discord Webhook URL (Alternative / Webhook mode)
DISCORD_WEBHOOK_URL=

# Polling Interval in milliseconds (Default: 60000 = 60 seconds)
FUNPAY_POLL_INTERVAL=60000

# Send startup message to Discord (true / false, Default: true)
STARTUP_MESSAGE=true

# Log level: debug, info, warn, error (Default: info)
LOG_LEVEL=info

# Optional HTTP Health check port (Default: 3000)
PORT=3000
